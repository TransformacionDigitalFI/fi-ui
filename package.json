{
  "name": "@fi-unam/ui",
  "version": "0.2.0",
  "description": "Lenguaje visual de la Facultad de Ingeniería, UNAM, sobre Nuxt UI v4: tokens de color y superficies, temas especiales, tipografía y fuentes, configuración de Nuxt UI, encabezado, pie y logotipos.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "style": "./src/css/index.css",
      "import": "./src/index.ts"
    },
    "./css": "./src/css/index.css",
    "./css/fonts": "./src/css/fonts.css",
    "./css/no-fonts": "./src/css/no-fonts.css",
    "./nuxt": "./src/nuxt/module.ts",
    "./vue": "./src/vue/plugin.ts",
    "./vite": {
      "types": "./src/vite.d.ts",
      "default": "./src/vite.js"
    },
    "./components/*": "./src/components/*",
    "./assets/*": "./src/assets/*",
    "./data": "./src/fi-data.ts",
    "./env": {
      "types": "./src/env.d.ts"
    }
  },
  "files": [
    "src",
    "skills",
    "AGENTS.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "defu": "^6.1.4"
  },
  "peerDependencies": {
    "@iconify-json/bi": "^1.2.0",
    "@iconify-json/fa6-brands": "^1.2.0",
    "@iconify-json/fa6-solid": "^1.2.0",
    "@iconify-json/ph": "^1.2.0",
    "@nuxt/kit": "^4.0.0",
    "@nuxt/ui": "^4.9.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@iconify-json/bi": {
      "optional": true
    },
    "@iconify-json/fa6-brands": {
      "optional": true
    },
    "@iconify-json/fa6-solid": {
      "optional": true
    },
    "@nuxt/kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@iconify-json/ph": "^1.2.2",
    "tailwindcss": "^4.3.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.39"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
